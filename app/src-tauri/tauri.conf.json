{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSAR",
  "mainBinaryName": "winsar-app",
  "version": "0.1.1",
  "identifier": "dev.winsar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinSAR",
        "width": 1000,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": { "icons/archive.ico": "archive.ico" },
    "fileAssociations": [
      {
        "ext": ["zip", "7z", "rar", "tar", "tgz", "tbz2", "txz", "tzst", "gz", "bz2", "xz", "zst"],
        "name": "WinSAR.Archive",
        "description": "Archive",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"] }
    }
  }
}
